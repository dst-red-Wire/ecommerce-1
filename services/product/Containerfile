ARG GO_BUILDER=docker.io/library/golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36
FROM --platform=$BUILDPLATFORM ${GO_BUILDER} AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN ["go", "mod", "download"]
COPY . .

ARG TARGETOS=linux
ARG TARGETARCH
ENV CGO_ENABLED=0
ENV GOOS=${TARGETOS}
ENV GOARCH=${TARGETARCH}
RUN ["go", "build", "-trimpath", "-buildvcs=false", "-ldflags=-s -w", "-o", "/out/product-api", "./cmd/product-api"]

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build --chown=65532:65532 /out/product-api /product-api
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/product-api"]
