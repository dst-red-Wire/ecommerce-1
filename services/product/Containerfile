ARG GO_BUILDER=docker.io/library/golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36
FROM --platform=$BUILDPLATFORM ${GO_BUILDER} AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN ["go", "mod", "download"]
COPY . .

ARG TARGETOS=linux
ARG TARGETARCH
ARG SOURCE_REVISION
ENV CGO_ENABLED=0
ENV GOOS=${TARGETOS}
ENV GOARCH=${TARGETARCH}
RUN ["go", "build", "-trimpath", "-buildvcs=false", "-ldflags=-s -w", "-o", "/out/product-api", "./cmd/product-api"]
RUN ["go", "build", "-trimpath", "-buildvcs=false", "-ldflags=-s -w", "-o", "/out/product-migrate", "./cmd/product-migrate"]

FROM scratch
ARG SOURCE_REVISION
LABEL org.opencontainers.image.title="ecommerce-product" \
      org.opencontainers.image.source="https://github.com/dst-red-Wire/ecommerce-1" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build --chown=65532:65532 /out/product-api /product-api
COPY --from=build --chown=65532:65532 /out/product-migrate /product-migrate
USER 65532:65532
EXPOSE 8080 9090
ENTRYPOINT ["/product-api"]
