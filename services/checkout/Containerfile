ARG GO_BUILDER=docker.io/library/golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36
FROM --platform=$BUILDPLATFORM ${GO_BUILDER} AS build
WORKDIR /src
COPY go.mod ./
RUN ["go", "mod", "download"]
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH
ENV CGO_ENABLED=0
ENV GOOS=${TARGETOS}
ENV GOARCH=${TARGETARCH}
RUN ["go", "build", "-trimpath", "-buildvcs=false", "-ldflags=-s -w", "-o", "/out/checkout", "./cmd/checkout-api"]

FROM scratch
COPY --from=build --chown=65532:65532 /out/checkout /checkout
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/checkout"]
