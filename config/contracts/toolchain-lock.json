    "ansible.posix": "1.5.4",
    "community.general": "8.3.0",
    "community.docker": "3.7.0",
    "community.crypto": "2.17.1",
    "community.sops": "1.6.7",
    "containers.podman": "1.11.0",
    "hetzner.hcloud": "2.4.1",
    "kubernetes.core": "2.4.0"
  },
  "language_contracts": {
    "go": {
      "toolchain_version_ref": "GO_VERSION",
      "workspace_language_directive": "1.25.0",
      "module_roots_source": "architecture.lock.yaml#business.services+business.frontend_runtime.module"
    },
    "python": {
      "seed_lock": "config/python/requirements.lock",
      "seed_roots": {
        "ansible-core": "ANSIBLE_CORE_VERSION",
        "PyYAML": "PYYAML_VERSION"
      }
    }
  },
  "projections": {
    "versions_env": {
      "path": "config/toolchain/versions.env",
      "mode": "generated-projection",
      "authority": "toolchain_lock.versions"
    },
    "ansible_collections": {
      "path": "platform/ansible/requirements.yml",
      "mode": "generated-projection",
      "authority": "toolchain_lock.ansible_collections"
    },
    "python_seed_lock": {
      "path": "config/python/requirements.lock",
      "mode": "hash-locked-projection",
      "authority": "toolchain_lock.language_contracts.python.seed_roots"
    },
    "capability_graph": {
      "path": "config/toolchain/capabilities.json",
      "mode": "operational-projection",
      "authority": "toolchain_lock.versions"
    },
    "bazel_version": {
      "path": ".bazelversion",
      "mode": "generated-projection",
      "authority": "toolchain_lock.native_tool_configs.bazel.version_ref"
    },
    "bazel_rc": {
      "path": ".bazelrc",
      "mode": "generated-projection",
      "authority": "toolchain_lock.native_tool_configs.bazel.bazelrc_lines"
    },
    "ansible_config": {
      "path": "platform/ansible/ansible.cfg",
      "mode": "generated-projection",
      "authority": "toolchain_lock.native_tool_configs.ansible"
    }
  },
  "rules": {
    "native_projection_drift": "block",
    "duplicate_version_authority": "forbidden",
    "unmanaged_cross_cutting_version": "forbidden"
  },
  "capability_policy": {
    "supported": {
      "os": [
        "linux",
        "darwin",
        "windows"
      ],
      "arch": [
        "amd64",
        "arm64"
      ]
    },
    "classifications": [
      "managed",
      "seed-prerequisite",
      "platform-provided",
      "conditional"
    ],
    "requirements": [
      "required-static",
      "optional-runtime"
    ],
    "managed_provision_types": [
      "ansible"
    ],
    "managed_bin_subdirectories": [
      ".local/bin"
    ],
    "command_capabilities": {
      "ansible": "ansible-core",
      "gofmt": "go",
      "pnpm": "pnpm",
      "docker": "docker",
      "terraform": "terraform",
      "tofu": "terraform",
      "sysctl": "container-network-forwarding",
      "bazel": "bazel"
    }
  },
  "native_tool_configs": {
    "bazel": {
      "version_ref": "BAZEL_VERSION",
      "bazelrc_lines": [
        "common --announce_rc",
        "build --show_timestamps",
        "test --test_output=errors"
      ]
    },
    "ansible": {
      "projection": "platform/ansible/ansible.cfg",
      "sections": {
        "defaults": {
          "forks": "30",
          "inventory": "inventories/mgmt/inventory.rb",
          "roles_path": "roles",
          "collections_path": "../../.ansible/collections",
          "collections_scan_sys_path": "False",
          "host_key_checking": "True",
          "retry_files_enabled": "False",
          "interpreter_python": "/usr/bin/python3",
          "stdout_callback": "default",
          "callback_result_format": "yaml"
        },
        "ssh_connection": {
          "pipelining": "True"
        }
      },
      "collections_install_root": ".ansible/collections"
    }
  }
}
