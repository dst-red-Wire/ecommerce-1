  "seed_prerequisites": [
    {
      "command": "python3",
      "justification": "Required to start repoctl and the bootstrap controller before managed provisioning can run."
    },
    {
      "command": "git",
      "justification": "Required to locate and inspect the checkout before repository orchestration starts."
    },
    {
      "command": "make",
      "justification": "Public gate dispatcher supplied by the build environment."
    },
    {
      "command": "ansible",
      "justification": "Pinned Ansible Core is supplied by the runner and drives repository-owned tool reconciliation."
    },
    {
      "command": "ansible-playbook",
      "justification": "The runner supplies this entry point from the same pinned Ansible Core provider."
    },
    {
      "command": "ansible-galaxy",
      "justification": "The runner supplies this entry point from the same pinned Ansible Core provider."
    },
    {
      "command": "ruby",
      "justification": "The runner supplies Ruby for deterministic governance validators; repository bootstrap never installs it."
    }
  ],
  "platform_primitives": [
    {
      "command": "tar",
      "justification": "POSIX archive primitive used only for an in-memory Git archive compatibility snapshot."
    },
    {
      "command": "diff",
      "justification": "POSIX comparison primitive used by generated-code drift checks."
    },
    {
      "command": "cc",
      "justification": "Platform compiler primitive required conditionally by CGO service integration tests."
    },
    {
      "command": "gh",
      "justification": "Authenticated forge transport used only by explicit delivery commands."
    },
    {
      "command": "curl",
      "justification": "TLS download primitive owned by supported platform bootstrap."
    },
    {
      "command": "unzip",
      "justification": "Archive primitive owned by supported platform bootstrap."
    }
  ],
