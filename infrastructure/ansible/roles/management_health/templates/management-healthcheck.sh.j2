#!/bin/sh
set -u

failures=
check() {
  check_name=$1
  shift
  if ! "$@" >/dev/null 2>&1; then
    failures="${failures}${check_name},"
  fi
}

check nftables systemctl is-active nftables
{% if inventory_hostname in groups['gitea_management'] or inventory_hostname in groups['harbor_management'] %}
check docker systemctl is-active docker
caddy_status=$(docker inspect --format '{% raw %}{{.State.Health.Status}}{% endraw %}' caddy 2>/dev/null || true)
if [ "$caddy_status" != healthy ]; then
  failures="${failures}caddy,"
fi
{% endif %}
{% if inventory_hostname in groups['gitea_management'] %}
check squid systemctl is-active squid
check gitea curl --fail --silent --show-error --max-time 10 http://127.0.0.1:3000/api/healthz
{% elif inventory_hostname in groups['harbor_management'] %}
check harbor curl --fail --silent --show-error --max-time 10 http://127.0.0.1:8080/api/v2.0/ping
{% else %}
check postgresql systemctl is-active postgresql
check pg_isready pg_isready --host={{ management_data_private_ip }} --port={{ management_postgresql_port }} --timeout=5
{% endif %}

if [ -n "$failures" ]; then
  logger --tag ecommerce-management-health \
    "{\"host\":\"{{ inventory_hostname }}\",\"status\":\"error\",\"failed\":\"${failures%,}\"}"
  exit 1
fi

logger --tag ecommerce-management-health \
  "{\"host\":\"{{ inventory_hostname }}\",\"status\":\"ok\"}"
