DO $terraform_state_role$
DECLARE
  role_password text;
BEGIN
  role_password := convert_from(
    decode('{{ terraform_state_postgresql_password | b64encode }}', 'base64'),
    'UTF8'
  );

  IF NOT EXISTS (
    SELECT 1 FROM pg_roles WHERE rolname = '{{ terraform_state_postgresql_user }}'
  ) THEN
    EXECUTE format(
      'CREATE ROLE {{ terraform_state_postgresql_user }} LOGIN '
      'NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT '
      'NOREPLICATION NOBYPASSRLS PASSWORD %L',
      role_password
    );
{% if terraform_state_postgresql_credential_check.rc != 0 %}
  ELSE
    EXECUTE format(
      'ALTER ROLE {{ terraform_state_postgresql_user }} LOGIN PASSWORD %L',
      role_password
    );
{% endif %}
  END IF;

  IF EXISTS (
    SELECT 1
    FROM pg_roles
    WHERE rolname = '{{ terraform_state_postgresql_user }}'
      AND (
        NOT rolcanlogin
        OR rolsuper
        OR rolcreatedb
        OR rolcreaterole
        OR rolinherit
        OR rolreplication
        OR rolbypassrls
      )
  ) THEN
    ALTER ROLE {{ terraform_state_postgresql_user }}
      LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS;
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM pg_roles
    WHERE rolname = '{{ terraform_state_postgresql_user }}'
      AND coalesce(rolconfig, ARRAY[]::text[]) @>
        ARRAY['statement_timeout=60s', 'idle_session_timeout=15min']
  ) THEN
    ALTER ROLE {{ terraform_state_postgresql_user }} SET statement_timeout = '60s';
    ALTER ROLE {{ terraform_state_postgresql_user }} SET idle_session_timeout = '15min';
  END IF;
END
$terraform_state_role$;
