services:
  caddy:
    image: caddy:{{ management_reverse_proxy_caddy_version }}-alpine@{{ management_reverse_proxy_caddy_image_digest }}
    container_name: caddy
    restart: unless-stopped
    network_mode: host
    read_only: true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:size=32m,mode=1777
    volumes:
      - {{ management_install_root }}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ management_root }}/caddy/data:/data
      - {{ management_root }}/caddy/config:/config
    healthcheck:
      test: ["CMD", "caddy", "validate", "--config", "/etc/caddy/Caddyfile"]
      interval: 30s
      timeout: 5s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: {{ management_docker_log_max_size | quote }}
        max-file: {{ management_docker_log_max_file | quote }}
