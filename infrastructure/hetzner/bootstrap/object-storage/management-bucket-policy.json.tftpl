{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTerraformBackupArchiveBucket",
      "Effect": "Allow",
      "Principal": {"AWS": "${management_principal}"},
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${bucket_name}"
    },
    {
      "Sid": "ReadLegacyManagementStateObject",
      "Effect": "Allow",
      "Principal": {"AWS": "${management_principal}"},
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::${bucket_name}/ecommerce/management/terraform.tfstate"
    },
    {
      "Sid": "ReadWriteLockDiagnosticObjects",
      "Effect": "Allow",
      "Principal": {"AWS": "${management_principal}"},
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:PutObjectAcl", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::${bucket_name}/ecommerce/lock-tests/terraform.tfstate",
        "arn:aws:s3:::${bucket_name}/ecommerce/lock-tests/terraform.tfstate.tflock"
      ]
    },
    {
      "Sid": "ReadWriteEncryptedBackupAndEvidenceArchives",
      "Effect": "Allow",
      "Principal": {"AWS": "${management_principal}"},
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:PutObjectAcl"],
      "Resource": [
        "arn:aws:s3:::${bucket_name}/ecommerce/backups/postgresql/*",
        "arn:aws:s3:::${bucket_name}/ecommerce/backups/bootstrap-terraform-state/*",
        "arn:aws:s3:::${bucket_name}/ecommerce/evidence/*"
      ]
    }
  ]
}
