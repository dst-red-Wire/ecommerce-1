package web

templ layout(data page) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width"/>
			<title>{ data.Title } · { data.Name }</title>
			<link rel="stylesheet" href="/assets/site.css"/>
			<script defer src="/assets/htmx.min.js"></script>
		</head>
		<body>
			<nav>
				<a href="/">{ data.Name }</a>
				if data.Admin {
					<a href="/products">Products</a>
					<a href="/orders">Orders</a>
					<a href="/stocks">Stocks</a>
				} else {
					<a href="/catalog">Catalog</a>
					<a href="/cart">Cart</a>
				}
			</nav>
			<main id="content">
				<h1>{ data.Title }</h1>
				@pageContent(data)
			</main>
		</body>
	</html>
}

templ pageContent(data page) {
	<div class="card">
		<p>{ data.Body }</p>
		if !data.Admin && data.Title == "Catalog" {
			<a href="/products/m1-demo">View M1 demonstration product</a>
		}
		if !data.Admin && data.Title == "Product" {
			<form method="post" action="/cart/items" hx-post="/cart/items" hx-target="#cart-count" hx-swap="outerHTML">
				<input type="hidden" name="product_id" value="m1-demo"/>
				<button type="submit">Add to cart</button>
			</form>
			<aside id="cart-count" aria-live="polite">0 items</aside>
		}
	</div>
}
