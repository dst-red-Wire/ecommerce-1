{
  "plugins": [
    "eslint",
    "typescript",
    "oxc",
    "unicorn",
    "react",
    "import",
    "jsx-a11y",
    "nextjs",
    "vitest"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": true
  },
  "settings": {
    "next": {
      "rootDir": [
        "apps/storefront",
        "apps/admin"
      ]
    }
  },
  "rules": {
    "nextjs/no-html-link-for-pages": "off",
    "jsx-a11y/control-has-associated-label": [
      "error",
      {
        "ignoreElements": [
          "audio",
          "canvas",
          "embed",
          "input",
          "td",
          "textarea",
          "tr",
          "video"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/node_modules/**",
    "playwright-report/**",
    "test-results/**",
    "screenshots/**"
  ]
}
