# Phase 1 uses deterministic mock adapters and needs no runtime endpoint.
# Future server-only BFF and IAM variables must not use NEXT_PUBLIC_ unless the
# browser genuinely needs to know their non-sensitive value.
NOMA_DATA_ADAPTER=mock
# Set to public to use DummyJSON products. Keep mock for deterministic CI.
# Pexels enrichment is optional and server-side only; never prefix this secret with NEXT_PUBLIC_.
PEXELS_API_KEY=
