#cloud-config
users:
  - default
  - name: ${jsonencode(gateway_user)}
    gecos: M1 qualification gateway administrator
    groups: [sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${jsonencode(ssh_public_key)}

# Terraform owns only the explicit gateway account and SSH bootstrap. The
# trusted controller's qualification_gateway role owns every stateful change.
