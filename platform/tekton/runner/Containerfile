FROM docker.io/library/debian@sha256:3c9c6d5c6a0df65e0f8f94b0b6f018cbb63f4e6f156f6769e4e95f5f8a2f6b74
ARG GO_VERSION=1.26.6
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates gcc git make python3 python3-yaml ruby protobuf-compiler curl && rm -rf /var/lib/apt/lists/*
# Release artifacts are fetched by the build task from tools.lock.yaml, checked
# against their sha256 values, and copied into /usr/local/bin in one layer.
COPY tools.lock.yaml /usr/share/ecommerce-runner/tools.lock.yaml
COPY scripts/repoctl.py /opt/ecommerce/scripts/repoctl.py
USER 65532:65532
ENTRYPOINT ["python3", "/opt/ecommerce/scripts/repoctl.py"]
