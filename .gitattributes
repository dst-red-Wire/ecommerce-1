# Normaliser les fichiers texte en LF (Linux/WSL)
* text=auto eol=lf

# Scripts Linux
*.sh text eol=lf
*.bash text eol=lf

# DevOps / configuration
*.yml text eol=lf
*.yaml text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf

# Scripts Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
