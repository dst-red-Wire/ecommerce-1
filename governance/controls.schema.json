{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-1.invalid/governance/controls.schema.json",
  "title": "ecommerce-1 canonical governance control register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_claim",
    "status_models",
    "architecture_requirements",
    "runtime_proofs",
    "controls"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "governance_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certification_claimed", "legal_advice", "statement"],
      "properties": {
        "certification_claimed": {"const": false},
        "legal_advice": {"const": false},
        "statement": {"type": "string", "minLength": 20}
      }
    },
    "status_models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcement", "runtime_evidence"],
      "properties": {
        "enforcement": {
          "const": ["DOCUMENTED", "STATICALLY_ENFORCED", "RUNTIME_ENFORCED", "PLANNED"]
        },
        "runtime_evidence": {
          "const": ["PROVEN_RUNTIME", "NOT_PROVEN_RUNTIME", "NOT_APPLICABLE"]
        }
      }
    },
    "architecture_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "H3_REQUIRED_FOR_PRODUCTION_EDGE",
        "HTTP2_FALLBACK_REQUIRED",
        "HTTP1_FALLBACK_REQUIRED_WHEN_NEEDED",
        "ZERO_RTT_POLICY",
        "TARGET_SLSA_BUILD_LEVEL"
      ],
      "properties": {
        "H3_REQUIRED_FOR_PRODUCTION_EDGE": {"const": true},
        "HTTP2_FALLBACK_REQUIRED": {"const": true},
        "HTTP1_FALLBACK_REQUIRED_WHEN_NEEDED": {"const": true},
        "ZERO_RTT_POLICY": {"const": "DISABLED_BY_DEFAULT"},
        "TARGET_SLSA_BUILD_LEVEL": {"const": "L3_CONDITIONAL_ON_BUILDER_VALIDATION"}
      }
    },
    "runtime_proofs": {
      "type": "array",
      "minItems": 13,
      "items": {"$ref": "#/$defs/runtimeProof"}
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "$defs": {
    "runtimeProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "status", "evidence"],
      "properties": {
        "capability": {"type": "string", "minLength": 3},
        "status": {
          "enum": ["PROVEN_RUNTIME", "NOT_PROVEN_RUNTIME", "PROVISIONAL_RUNTIME_PASS", "NOT_MIGRATED"]
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "category", "statement", "rationale", "scope",
        "environments", "enforcement_status", "runtime_status", "severity",
        "evidence", "framework_mappings", "exception_allowed", "owner_role",
        "implementation_notes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(ARCH|SEC|PRIV|SUPPLY|COMP|IAM|DATA|NET|CRYPTO|SDLC|RES|OBS|IMM|H3)-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 5},
        "category": {"type": "string", "minLength": 3},
        "statement": {"type": "string", "minLength": 20},
        "rationale": {"type": "string", "minLength": 20},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "environments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "enforcement_status": {"enum": ["DOCUMENTED", "STATICALLY_ENFORCED", "RUNTIME_ENFORCED", "PLANNED"]},
        "runtime_status": {"enum": ["PROVEN_RUNTIME", "NOT_PROVEN_RUNTIME", "NOT_APPLICABLE"]},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "framework_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}},
        "exception_allowed": {"type": "boolean"},
        "owner_role": {"enum": ["platform", "security", "application", "data", "operations", "privacy"]},
        "implementation_notes": {"type": "string", "minLength": 5}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "notes"],
      "properties": {
        "type": {
          "enum": ["policy", "policy_test", "test", "config", "runtime_probe", "scanner", "sbom", "provenance", "signature_verification", "independent_review"]
        },
        "status": {"enum": ["AVAILABLE", "EXTERNAL_REVIEWED", "PLANNED"]},
        "path": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 3},
        "notes": {"type": "string", "minLength": 5}
      },
      "anyOf": [{"required": ["path"]}, {"required": ["reference"]}]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "control", "relationship", "notes"],
      "properties": {
        "framework": {"type": "string", "minLength": 2},
        "control": {"type": "string", "minLength": 1},
        "project_control_id": {"type": "string", "pattern": "^(ARCH|SEC|PRIV|SUPPLY|COMP|IAM|DATA|NET|CRYPTO|SDLC|RES|OBS|IMM|H3)-[0-9]{3}$"},
        "relationship": {"enum": ["SUPPORTS", "PARTIAL", "INFORMATIVE", "CONDITIONAL"]},
        "notes": {"type": "string", "minLength": 5}
      }
    }
  }
}
